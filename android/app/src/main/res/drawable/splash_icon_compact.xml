<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 uses a 288dp icon canvas. Keep the 96dp logo inside its safe area. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:width="96dp" android:height="96dp" android:gravity="center">
        <bitmap android:gravity="fill" android:src="@drawable/splash" />
    </item>
</layer-list>
